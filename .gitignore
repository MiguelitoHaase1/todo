# Nested pwa repo (separate todolist-pwa.git)
pwa/

# Logs
logs
*.log
npm-debug.log*

# Dependencies
#
# NO TRAILING SLASHES on these. Heavy state in this vault lives in ~/AI-local/ behind symlinks, and
# node_modules here IS one. A `foo/` pattern matches directories only — git sees a symlink as a file,
# so `node_modules/` silently failed to ignore it and every status listed it as untracked.
node_modules
dist
.next
.turbo

# Editor / OS
.DS_Store
.idea
.vscode/*
!.vscode/extensions.json
*.suo
*.sw?

# Secrets — never commit
.env
.env.*
!.env.example

# Build artifacts (slashless for the same reason as above)
*.tsbuildinfo
coverage
bun.lockb

# Playwright debug
.playwright-mcp/

# Local state
.build-state.json
.build-sessions/
.archetype-state.json
.eval-state.json
.strategy-state.json
.onboard-state.json
